      function initMoreMenu() {
        var btn = document.getElementById('more-btn');
        var dropdown = document.getElementById('more-dropdown');
        if (!btn || !dropdown) return;
        btn.classList.remove('open');
        dropdown.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        if (btn._moreInit) return;
        btn._moreInit = true;
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var isOpen = dropdown.classList.toggle('open');
          btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        document.addEventListener('click', function(e) {
          if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.remove('open');
            btn.setAttribute('aria-expanded', 'false');
          }
        });
      }
      function checkNavCollision() {
        var navCenter = document.querySelector('.nav-center');
        var kofi = document.querySelector('.desktop-kofi');
        var leftSection = document.getElementById('header-left');
        if (!navCenter || !leftSection) return;
        navCenter.classList.remove('nav-collapsed');
        if (kofi) kofi.classList.remove('nav-collapsed');
        var leftRect = leftSection.getBoundingClientRect();
        var navRect = navCenter.getBoundingClientRect();
        var kofiRect = kofi ? kofi.getBoundingClientRect() : null;
        var buffer = 4;
        var overlapsLeft = navRect.left < leftRect.right + buffer;
        var overlapsRight = kofiRect && navRect.right > kofiRect.left - buffer;
        if (overlapsLeft || overlapsRight) {
          navCenter.classList.add('nav-collapsed');
          if (kofi) kofi.classList.add('nav-collapsed');
        }
      }
      var navCollisionScheduled = false;
      function scheduleNavCollision() {
        if (navCollisionScheduled) return;
        navCollisionScheduled = true;
        requestAnimationFrame(function() {
          navCollisionScheduled = false;
          checkNavCollision();
        });
      }
      function initNavCollision() {
        scheduleNavCollision();
        if (!window._navCollisionInit) {
          window._navCollisionInit = true;
          window.addEventListener('resize', scheduleNavCollision);
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(scheduleNavCollision);
